+# ============================================================
+# A3 — Cấu hình riêng cho test tích hợp (Testcontainers MySQL)
+# Datasource KHÔNG khai báo ở đây: @ServiceConnection tự nạp từ container.
+# ============================================================
+
+# Hibernate tự tạo schema từ entity trong container sạch, xoá sau khi xong.
+spring.jpa.hibernate.ddl-auto=create-drop
+spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
+spring.jpa.show-sql=false
+spring.jpa.open-in-view=false
+
+# Không chạy khởi tạo SQL nào khi test.
+spring.sql.init.mode=never
+
+# Giá trị giả để context khởi động được (test không dùng tới các dịch vụ này).
+jwt.secret=test-secret-please-ignore-0123456789-0123456789-0123456789
+jwt.expiration-ms=86400000
+jwt.refresh-expiration-ms=604800000
+cloudinary.cloud-name=test
+cloudinary.api-key=test
+cloudinary.api-secret=test
